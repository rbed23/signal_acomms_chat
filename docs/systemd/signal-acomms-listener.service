# EXAMPLE systemd unit for the downlink (Signal -> ACOMMS).
# Adjust User and paths, then:
#   sudo cp docs/systemd/signal-acomms-*.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now signal-acomms-listener signal-acomms-uplink
[Unit]
Description=Signal -> ACOMMS chat downlink
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=acomms
WorkingDirectory=/opt/signal_acomms_chat
ExecStart=/opt/signal_acomms_chat/.venv/bin/python signal_cli_app_listener_daemon.py -c /opt/signal_acomms_chat/config.toml
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
