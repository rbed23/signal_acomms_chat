# Environment for docker compose (EXAMPLE)
#
#   cp docs/env.example .env
#
# .env is git-ignored. Any SACOMMS_<SECTION>_<KEY> variable overrides the
# matching config.toml value (lists are comma-separated).

# The bridge's own Signal number (E.164)
SACOMMS_SIGNAL_SERVER_NUMBER=+15555550100

# Who may send into the acoustic network
SACOMMS_BRIDGE_ALLOWED_SENDERS=+15555550123

# Where the real rosbridge runs, as seen from inside the bridge containers.
# host.docker.internal works on Docker Desktop and, with the extra_hosts
# entry in docker-compose.yml, on Linux.
SACOMMS_ROSBRIDGE_HOST=host.docker.internal
SACOMMS_ROSBRIDGE_PORT=9090

# signal-cli-rest-api mode: json-rpc streams incoming messages (recommended)
SIGNAL_API_MODE=json-rpc
